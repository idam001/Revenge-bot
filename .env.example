# Postgres / Supabase connection string (Supavisor session pooler, port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Public Supabase project credentials (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Optional provider keys — can also be added at runtime via the app's Universal API Key Vault
# E2B_API_KEY=
# HF_TOKEN=
# AIHORDE_API_KEY=
