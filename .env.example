# Postgres / Supabase connection string (Supavisor session pooler, port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Public Supabase project credentials (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Optional provider keys — can also be added at runtime via the app's Universal API Key Vault
# E2B_API_KEY=
# HF_TOKEN=
# AIHORDE_API_KEY=

# Server-only tool provider credentials (never add NEXT_PUBLIC_ to these)
# NABEES_API_KEY=
# EMAILOSINT_API_KEY=

# Optional user website hosting (Cloudflare Pages Direct Upload)
# Create a fresh, least-privilege Cloudflare API token with Pages Write only.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
